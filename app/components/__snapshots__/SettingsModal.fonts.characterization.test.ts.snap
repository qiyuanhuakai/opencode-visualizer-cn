exports[`SettingsModal fonts page characterization > locks the canonical rendered DOM of both font rows 1`] = `
{
  "app": "<div class="setting-row setting-row-font"><div class="setting-info"><div class="setting-label">App monospace font family</div><div class="setting-description">Shared monospace stack for panels, dialogs, tool placeholders, inline code, and badges.</div></div><div class="font-setting-controls"><div class="font-setting-section"><label class="font-setting-section-label" for="settings-app-font-size">Code view font size</label><div class="number-setting-group"><input class="number-input" id="settings-app-font-size" max="20" min="10" step="1" type="number"></input></div><div class="setting-description" style="margin-top: 2px;">Font size in pixels for code views, diff viewers, and output panels.</div></div><div class="font-setting-section"><label class="font-setting-section-label" for="settings-message-font-size">Message font size</label><div class="number-setting-group"><input class="number-input" id="settings-message-font-size" max="20" min="10" step="1" type="number"></input></div><div class="setting-description" style="margin-top: 2px;">Font size in pixels for chat messages and thread history.</div></div><div class="font-setting-section"><label class="font-setting-section-label" for="settings-sidebar-font-size">Sidebar font size</label><div class="number-setting-group"><input class="number-input" id="settings-sidebar-font-size" max="20" min="10" step="1" type="number"></input></div><div class="setting-description" style="margin-top: 2px;">Font size in pixels for file trees, session trees, and todo text.</div></div><div class="font-setting-section"><label class="font-setting-section-label" for="settings-ui-font-size">UI font size</label><div class="number-setting-group"><input class="number-input" id="settings-ui-font-size" max="16" min="10" step="1" type="number"></input></div><div class="setting-description" style="margin-top: 2px;">Font size in pixels for the top panel, modals, and dropdowns.</div></div><div class="font-setting-section font-setting-suboption"><label class="font-setting-section-label">Editor font size</label><div class="editor-number-control"><input class="number-input" max="28" min="10" placeholder="Inherit" step="1" type="number"></input><button class="font-system-button" type="button">Inherit</button></div><div class="setting-description" style="margin-top: 2px;">CodeMirror font size in pixels.</div></div><div class="font-setting-section"><div class="font-setting-section-label" id="settings-app-font-presets">Presets</div><div aria-labelledby="settings-app-font-presets" class="font-preset-row" role="group"><button aria-pressed="true" class="font-preset-chip is-active" type="button">Default</button><button aria-pressed="false" class="font-preset-chip" type="button">SF Mono</button><button aria-pressed="false" class="font-preset-chip" type="button">JetBrains Mono</button><button aria-pressed="false" class="font-preset-chip" type="button">Fira Code</button><button aria-pressed="false" class="font-preset-chip" type="button">Iosevka Term</button></div></div><div class="font-setting-section"><label class="font-setting-section-label" for="settings-app-font-input" id="settings-app-font-input-label">Custom font stack</label><textarea aria-describedby="settings-app-font-presets" autocapitalize="off" autocomplete="off" class="font-stack-input" id="settings-app-font-input" placeholder="'SF Mono', 'JetBrains Mono', 'Fira Code', ui-monospace, 'SFMono-Regular', 'Menlo', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace" rows="3" spellcheck="false"></textarea><div aria-live="polite" class="font-stack-status-list" role="status"><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">SF Mono</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">JetBrains Mono</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">Fira Code</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-generic"><span class="font-stack-status-name">ui-monospace</span><span class="font-stack-status-value">Generic fallback</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">SFMono-Regular</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">Menlo</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">Monaco</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">Consolas</span><span class="font-stack-status-value">No match</span></div></div></div><div class="font-setting-section"><button aria-expanded="false" class="font-discovery-toggle" type="button"><span>Detected system fonts</span><svg class="iconify" data-icon="lucide:chevron-down"></svg></button></div></div></div>",
  "terminal": "<div class="setting-row setting-row-font"><div class="setting-info"><div class="setting-label">Terminal font family</div><div class="setting-description">Font stack used only by xterm shell windows. Put your preferred Nerd Font first.</div></div><div class="font-setting-controls"><div class="font-setting-section"><label class="font-setting-section-label" for="settings-terminal-font-size">Terminal font size</label><div class="number-setting-group"><input class="number-input" id="settings-terminal-font-size" max="24" min="8" step="1" type="number"></input></div><div class="setting-description" style="margin-top: 2px;">Font size in pixels for xterm shell windows.</div></div><div class="font-setting-section"><div class="font-setting-section-label" id="settings-terminal-font-presets">Presets</div><div aria-labelledby="settings-terminal-font-presets" class="font-preset-row" role="group"><button aria-pressed="true" class="font-preset-chip is-active" type="button">Default</button><button aria-pressed="false" class="font-preset-chip" type="button">FiraCode Nerd</button><button aria-pressed="false" class="font-preset-chip" type="button">Caskaydia Nerd</button><button aria-pressed="false" class="font-preset-chip" type="button">Iosevka Term</button><button aria-pressed="false" class="font-preset-chip" type="button">JetBrains Mono</button></div></div><div class="font-setting-section"><label class="font-setting-section-label" for="settings-terminal-font-input" id="settings-terminal-font-input-label">Custom font stack</label><textarea aria-describedby="settings-terminal-font-presets" autocapitalize="off" autocomplete="off" class="font-stack-input" id="settings-terminal-font-input" placeholder="'FiraCode Nerd Font Mono', 'FiraCode Nerd Font Mono Med', 'CaskaydiaCove Nerd Font Mono', 'CaskaydiaCove NFM', 'IosevkaTerm Nerd Font', 'Iosevka Term', 'Iosevka Fixed', 'JetBrains Mono', 'Cascadia Mono', 'SFMono-Regular', 'Menlo', 'Consolas', 'Liberation Mono', monospace" rows="3" spellcheck="false"></textarea><div aria-live="polite" class="font-stack-status-list" role="status"><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">FiraCode Nerd Font Mono</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">FiraCode Nerd Font Mono Med</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">CaskaydiaCove Nerd Font Mono</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">CaskaydiaCove NFM</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">IosevkaTerm Nerd Font</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">Iosevka Term</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">Iosevka Fixed</span><span class="font-stack-status-value">No match</span></div><div class="font-stack-status-item is-missing"><span class="font-stack-status-name">JetBrains Mono</span><span class="font-stack-status-value">No match</span></div></div></div><div class="font-setting-section"><button aria-expanded="false" class="font-discovery-toggle" type="button"><span>Detected system fonts</span><svg class="iconify" data-icon="lucide:chevron-down"></svg></button></div></div></div>",
}
