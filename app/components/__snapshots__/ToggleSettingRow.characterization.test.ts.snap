// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SettingsModal toggle rows characterization > locks the canonical rendered DOM of every toggle setting row 1`] = `
{
  "dockAlwaysOpen": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Keep dock always visible</div><div class="setting-description">Keep the dock bar visible even when no window is minimized. Only available when minimization is enabled.</div></div><label class="toggle-switch" title="Keep dock always visible"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "editInVis": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Edit in Vis</div><div class="setting-description">Enable built-in file editing through the local vis_bridge.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "enterToSend": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Enter to send</div><div class="setting-description">Send messages by pressing Enter. When off, use Ctrl+Enter.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "floatingPreviewWordWrap": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Floating preview word wrap</div><div class="setting-description">Enable automatic line wrapping in floating windows with line numbers (file preview, edit/write/patch).</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "showCodexButton": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Show Codex panel button</div><div class="setting-description">Display the Codex panel button next to the Forge panel button.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "showCodexInStatusMonitor": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Show Codex in status monitor</div><div class="setting-description">Display a dedicated Codex tab in the status monitor popover.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "showForgePanelButton": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Show Forge panel button</div><div class="setting-description">Display the lightweight Forge PTY panel button next to management mode.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "showMinimizeButtons": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Show minimize button</div><div class="setting-description">Toggle window minimization controls. Turning this off also restores all minimized windows.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "showOpenInEditorButton": "<div class="setting-row"><div class="setting-info"><div class="setting-label">Show "Open in Editor" button</div><div class="setting-description">Display an "Open in Editor" button on file preview windows.</div></div><label class="toggle-switch"><input class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
  "textTransformersEnabled": "<div class="setting-row"><div class="setting-info"><div class="setting-label" id="settings-text-transformers-enabled-label">Enable text transformers</div><div class="setting-description" id="settings-text-transformers-enabled-description">Show completions and expand configured backslash sequences in the composer.</div></div><label class="toggle-switch"><input aria-describedby="settings-text-transformers-enabled-description" aria-labelledby="settings-text-transformers-enabled-label" class="toggle-input" type="checkbox"></input><span class="toggle-track"></span></label></div>",
}
`;
