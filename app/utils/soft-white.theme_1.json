    "shell": { "accent": "#5d8a80", "backgroundColor": "#ecefeb", "titlebarOpacity": "1" },
    "reasoning": { "accent": "#547789", "backgroundColor": "#f1f0ed" },
    "subagent": { "accent": "#5d8a80", "backgroundColor": "#edf2f1" },
    "tool": { "accent": "#ad815e", "backgroundColor": "#f3f1ec" },
    "file": { "accent": "#547789", "backgroundColor": "#eff2f1" },
    "diff": { "accent": "#ad815e", "backgroundColor": "#f2efed" },
    "media": { "accent": "#5d8a80", "backgroundColor": "#eff2f1" },
    "dialog": { "accent": "#547789", "backgroundColor": "#f5f3ef" },
    "history": { "accent": "#5d8a80", "backgroundColor": "#f1f2ef" },
    "debug": { "accent": "#66747c", "backgroundColor": "#ecefed" }
  }
