{
  "name": "opencode_visualizer_cn",
  "version": "0.7.7",
  "description": "Vis - OpenCode Visualizer",
  "keywords": [
    "opencode",
    "webui"
  ],
  "homepage": "https://github.com/qiyuanhuakai/opencode-visualizer-cn",
  "license": "MIT",
  "author": "qiyuanhuakai",
  "repository": {
    "url": "https://github.com/qiyuanhuakai/opencode-visualizer-cn"
  },
  "bin": {
    "vis": "server.js",
    "vis_bridge": "vis_bridge.js"
  },
  "files": [
    "server.js",
    "vis_bridge.js",
    "vis_bridge.d.ts",
    "bridge",
    "scripts/build-vis-bridge.mjs",
    "dist",
    "electron"
  ],
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "prepack": "vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check package.json postcss.config.mjs .oxlintrc.json .oxfmtrc.json app/styles/tailwind.css app/toolingConfig.test.ts",
    "bridge:build": "node scripts/build-vis-bridge.mjs",
    "bridge:package-installer": "node scripts/package-vis-bridge-installer.mjs",
    "lint": "oxlint && vue-tsc --noEmit",
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "electron:start": "node scripts/electron-start.mjs",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron-builder --dir",
    "qa:electron": "node scripts/qa/electron-smoke.mjs",
    "qa:pty": "node scripts/qa/node-pty-dual-runtime.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@fiahfy/icns": "^0.0.7",
    "@hono/node-server": "^2.1.0",
    "@vue-symbols/icons": "1.2.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.1",
    "jszip": "^3.10.1",
    "libarchive-wasm": "^1.2.0",
    "nanotar": "^0.3.0",
    "vue-codemirror6": "^1.6.1",
    "vue-i18n": "^11.4.8",
    "vue-pdf-embed": "^2.1.5"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@kikuchan/hexdump": "0.1.0-alpha.9",
    "@shikijs/markdown-it": "^4.4.3",
    "@shikijs/stream": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.2",
    "markdown-it": "^15.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "1.62.1",
    "postcss": "^8.5.26",
    "postject": "1.0.0-alpha.6",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "optionalDependencies": {
    "node-pty": "^1.2.0-beta.12"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.21.0"
}
