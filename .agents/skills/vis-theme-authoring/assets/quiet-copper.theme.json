    "chatCard": { "bg": "linear-gradient(135deg, #f7f3ec, #ecf0e9)", "text": "#28383b", "border": "#ccd2cd", "accent": "#a66d4e", "controlBg": "#f5f2ec", "activeBg": "#e9d9cc", "activeText": "#64402e", "textMuted": "#586b6e" }
