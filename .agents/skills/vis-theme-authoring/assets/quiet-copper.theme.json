    "loginScreen": { "bg": "radial-gradient(circle at 20% 10%, #e0eae5, transparent 45%), linear-gradient(155deg, #f0ece3, #e2e9e4)", "text": "#28383b", "border": "#c8ceca", "accent": "#4f807c", "controlBg": "#f5f2ec", "activeBg": "#d6e5df", "activeText": "#234c4b", "textMuted": "#586b6e" },
